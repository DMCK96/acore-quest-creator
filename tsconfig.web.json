{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // src/core is part of this project (the renderer imports it) and core runs under
    // plain Node, so `node:*` imports must resolve here too.
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "composite": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@core/*": ["./src/core/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "package.json",
    "tests/renderer/**/*",
    "tests/helpers/**/*"
  ],
  // An in-memory stand-in for the main process's project file system: node-only.
  "exclude": ["tests/helpers/mem-fs.ts"]
}
