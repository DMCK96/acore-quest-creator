---
/**
 * A row of the canvas's quest cards joined by its gold threads, each one linking to a guide.
 * Stacks into a column on narrow screens, with the threads running down between the cards.
 */
interface Step {
	title: string;
	meta: string;
	chip: string;
	href: string;
	text: string;
}

const { steps } = Astro.props as { steps: Step[] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<ol class="quest-chain not-content">
	{
		steps.map((step) => (
			<li class="quest-chain__step">
				<a class="quest-chain__card" href={base + step.href}>
					<span class="quest-chain__title">{step.title}</span>
					<span class="quest-chain__meta">{step.meta}</span>
					<span class="quest-chain__chip">{step.chip}</span>
					<span class="quest-chain__text">{step.text}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	.quest-chain {
		--thread: 2.2rem;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.4rem var(--thread);
		margin: 2.5rem 0 1rem;
		padding: 0;
		list-style: none;
	}

	.quest-chain__step {
		position: relative;
		display: flex;
	}

	/* The thread to the next card, ending in the canvas's round handles. */
	.quest-chain__step:not(:last-child)::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 100%;
		width: var(--thread);
		height: 1px;
		background: var(--sl-color-accent);
		opacity: 0.8;
	}

	.quest-chain__step:not(:last-child)::before,
	.quest-chain__step:not(:first-child) .quest-chain__card::before {
		content: '';
		position: absolute;
		z-index: 1;
		top: 50%;
		width: 7px;
		height: 7px;
		margin-top: -3.5px;
		border: 1px solid var(--sl-color-accent);
		border-radius: 50%;
		background: var(--sl-color-bg);
	}

	.quest-chain__step:not(:last-child)::before {
		right: -4px;
	}

	.quest-chain__step:not(:first-child) .quest-chain__card::before {
		left: -4px;
	}

	.quest-chain__card {
		position: relative;
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.2rem;
		padding: 0.9rem 1rem 1rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 8px;
		background: var(--sl-color-gray-5);
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s ease-out,
			box-shadow 0.15s ease-out;
	}

	.quest-chain__card:hover,
	.quest-chain__card:focus-visible {
		border-color: var(--sl-color-accent);
		box-shadow:
			0 0 0 2px color-mix(in srgb, var(--sl-color-accent) 18%, transparent),
			0 4px 16px rgba(0, 0, 0, 0.35);
		outline: none;
	}

	.quest-chain__title {
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 1.15rem;
		line-height: 1.3;
		color: var(--sl-color-white);
		text-wrap: balance;
	}

	.quest-chain__meta {
		font-size: 0.78rem;
		color: var(--sl-color-gray-3);
	}

	.quest-chain__chip {
		margin-block: 0.35rem 0.3rem;
		padding: 0.1em 0.6em;
		border: 1px solid var(--sl-color-accent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--sl-color-accent) 16%, transparent);
		color: var(--sl-color-accent);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.quest-chain__text {
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}

	:global(:root[data-theme='light']) .quest-chain__card {
		background: var(--sl-color-gray-7);
		box-shadow: 0 4px 16px rgba(40, 28, 16, 0.08);
	}

	/* One column: the threads run down between the cards instead of across. */
	@media (max-width: 64rem) {
		.quest-chain {
			grid-template-columns: 1fr;
			gap: var(--thread);
		}

		.quest-chain__step:not(:last-child)::after {
			top: 100%;
			left: 50%;
			width: 1px;
			height: var(--thread);
		}

		.quest-chain__step:not(:last-child)::before {
			top: 100%;
			right: auto;
			left: 50%;
			margin: -4px 0 0 -3.5px;
		}

		.quest-chain__step:not(:first-child) .quest-chain__card::before {
			top: -4px;
			left: 50%;
			margin: 0 0 0 -3.5px;
		}
	}
</style>
