{
  "name": "acore-quest-creator",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "ACORE Quest Creator",
  "author": "Daniel Mckibbin <vyrus@fourtwenty.games>",
  "license": "GPL-3.0-or-later",
  "homepage": "https://dmck96.github.io/acore-quest-creator/",
  "repository": {
    "type": "git",
    "url": "https://github.com/DMCK96/acore-quest-creator.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run rebuild:electron && electron-vite dev",
    "build": "npm run rebuild:electron && electron-vite build",
    "test": "npm run rebuild:node && vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run rebuild:electron && electron-vite build && electron-builder",
    "corpus": "tsx scripts/corpus.ts",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "release:check-tag": "tsx scripts/check-tag-version.ts",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm --prefix site run build",
    "docs:screenshots": "npm run build && playwright test -c playwright.docs.config.ts"
  },
  "dependencies": {
    "@tsparticles/engine": "^4.4.0",
    "@tsparticles/react": "^4.4.0",
    "@tsparticles/slim": "^4.4.0",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "leaflet": "^1.9.4",
    "motion": "^13.4.1",
    "mysql2": "^3.24.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "seek-bzip": "^2.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
