# Copy to .env. The app saves these as the "World (.env)" profile and connects on launch. Any
# unpackaged launch reads it: `npm run dev`, and Playwright's `electron out/main/index.js` (after
# `npm run build`). Packaged apps ignore it. Set ACQC_ENV_FILE=none to skip it.
ACQC_WORLD_DB_HOST=127.0.0.1
ACQC_WORLD_DB_PORT=3306
ACQC_WORLD_DB_USER=acore
ACQC_WORLD_DB_PASSWORD=acore
ACQC_WORLD_DB_DATABASE=acore_world

# Optional: a dev database for "Apply to dev". Leave HOST empty to skip it.
ACQC_DEV_DB_HOST=
ACQC_DEV_DB_PORT=3306
ACQC_DEV_DB_USER=
ACQC_DEV_DB_PASSWORD=
ACQC_DEV_DB_DATABASE=
